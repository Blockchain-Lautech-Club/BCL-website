  "cohorts": {
    "header": "Level up your Web3 Skills with a Cohorts",
    "subHeader": "Our Cohort Programs are structured learning tracks designed to help students gain real-world blockchain skills in focused areas.",
    "tracks": [
      {
        "id": "dev-cohort-1",
        "title": "Web & Blockchain Dev Cohort",
        "category": "Development",
        "description": "Build modern web apps and decentralized applications from scratch, frontend to smart contracts.",
        "status": "Now Open",
        "duration": "12 Weeks",
        "slotsAvailable": 100,
        "format": "Hybrid",
        "learningPoints": [
          "Frontend & Backend",
          "Solidity",
          "Blockchain Fundamentals",
          "DeFi & NFTs",
          "Web3 Integration"
        ],
        "targetAudience": "Aspiring developers who want to build real blockchain-based products from day one.",
        "curriculum": {
          "phase1": {
            "title": "Web2 Track (Foundation)",
            "subtitle": "Core technologies for building modern web applications...",
            "topics": [
              "HTML, CSS & JavaScript",
              "Git & GitHub",
              "Building & deploying web projects",
              "APIs & databases",
              "Next.js & Node.js"
            ],
            "outcome": "Build and deploy functional web applications and understand modern development workflows."
          },
          "phase2": {
            "title": "Web3 Track (Blockchain)",
            "subtitle": "Transition into decentralized development...",
            "topics": [
              "Blockchain Fundamentals & Web3",
              "Smart contracts & dApps",
              "Web3 Testing",
              "Wallets, transactions & basic chains",
              "Building on real blockchain ecosystem"
            ],
            "outcome": "Build basic dApps and understand how blockchain integrates with web applications end-to-end."
          }
        },
        "timeline": [
          {
            "weeks": "Weeks 1-4",
            "title": "Web Fundamentals",
            "detail": "HTML, CSS, JavaScript basics & version control"
          },
          {
            "weeks": "Weeks 5-6",
            "title": "Frameworks & Backend",
            "detail": "Next.js, Node.js, APIs & database integration"
          },
          {
            "weeks": "Weeks 7-9",
            "title": "Blockchain Foundation",
            "detail": "Web3 concepts, wallets, on-chain interactions"
          },
          {
            "weeks": "Weeks 10-12",
            "title": "Build & Ship",
            "detail": "Smart contracts, dApp dev & final project demo"
          }
        ]
      },
      {
        "id": "design-product-cohort",
        "title": "Design & Product Cohort",
        "category": "UI/UX & Product",
        "description": "Design user-friendly and visually compelling Web3 products that people actually want to use.",
        "status": "Opening Soon",
        "learningPoints": [
          "UI/UX for Web3",
          "Product Design",
          "Branding Systems",
          "Figma",
          "Prototyping"
        ],
        "targetAudience": "Creative students into design, branding, and user experience within the Web3 space."
      }
    ]
  },
